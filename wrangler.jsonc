{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-mfe-module-registry-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "env": {
    "preview": {
      "vars": {
        "ENVIRONMENT": "dev",
        "SERVICE_TITLE": "MFE Module Registry",
        "GOOGLE_AUTH_ENABLED": "true",
        "GOOGLE_AUTH_ALLOWED_AUDIENCES": "",
        "GOOGLE_AUTH_ALLOWED_EMAILS": "",
        "GOOGLE_AUTH_ALLOWED_DOMAINS": "",
        "GOOGLE_AUTH_ALLOWED_GROUPS": "",
        "GOOGLE_AUTH_GROUPS_SERVICE_ACCOUNT_EMAIL": "",
        "GOOGLE_AUTH_GROUPS_SERVICE_ACCOUNT_PRIVATE_KEY": "",
        "GOOGLE_AUTH_GROUPS_IMPERSONATED_USER": "",
        "GOOGLE_AUTH_GROUPS_CACHE_TTL_SECONDS": "300",
        "PUBLISH_UPLOADS_ENABLED": "true",
        "PUBLISH_UPLOADS_PUBLIC_BASE_URL": "",
        "PUBLISH_UPLOADS_R2_PREFIX": "modules",
        "PUBLISH_UPLOADS_MAX_BUNDLE_BYTES": "52428800",
        "PUBLISH_UPLOADS_MAX_MANIFEST_BYTES": "5242880"
      },
      "r2_buckets": [
        {
          "binding": "REGISTRY_ASSETS",
          "bucket_name": "mfe-module-registry-dev-assets"
        }
      ],
      "d1_databases": [
        {
          "binding": "REGISTRY_DB",
          "database_name": "mfe-module-registry-dev"
        }
      ]
    },
    "production": {
      "vars": {
        "ENVIRONMENT": "prod",
        "SERVICE_TITLE": "MFE Module Registry",
        "GOOGLE_AUTH_ENABLED": "true",
        "GOOGLE_AUTH_ALLOWED_AUDIENCES": "",
        "GOOGLE_AUTH_ALLOWED_EMAILS": "",
        "GOOGLE_AUTH_ALLOWED_DOMAINS": "",
        "GOOGLE_AUTH_ALLOWED_GROUPS": "",
        "GOOGLE_AUTH_GROUPS_SERVICE_ACCOUNT_EMAIL": "",
        "GOOGLE_AUTH_GROUPS_SERVICE_ACCOUNT_PRIVATE_KEY": "",
        "GOOGLE_AUTH_GROUPS_IMPERSONATED_USER": "",
        "GOOGLE_AUTH_GROUPS_CACHE_TTL_SECONDS": "300",
        "PUBLISH_UPLOADS_ENABLED": "true",
        "PUBLISH_UPLOADS_PUBLIC_BASE_URL": "",
        "PUBLISH_UPLOADS_R2_PREFIX": "modules",
        "PUBLISH_UPLOADS_MAX_BUNDLE_BYTES": "52428800",
        "PUBLISH_UPLOADS_MAX_MANIFEST_BYTES": "5242880"
      },
      "r2_buckets": [
        {
          "binding": "REGISTRY_ASSETS",
          "bucket_name": "mfe-module-registry-prod-assets"
        }
      ],
      "d1_databases": [
        {
          "binding": "REGISTRY_DB",
          "database_name": "mfe-module-registry-prod"
        }
      ]
    }
  }
}
